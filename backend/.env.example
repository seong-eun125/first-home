# ------------------------------------------------------------
# FIRST HOME 백엔드 환경변수 예시
# 이 파일을 복사해 같은 폴더에 .env 로 저장한 뒤 값을 채우세요.
#   Windows : copy .env.example .env
#   macOS   : cp .env.example .env
# .env 파일은 .gitignore에 들어 있어 GitHub에 올라가지 않습니다.
# ------------------------------------------------------------

# MySQL 접속 정보: mysql+pymysql://사용자:비밀번호@호스트:포트/DB이름?charset=utf8mb4
DATABASE_URL=mysql+pymysql://firsthome:firsthome_pw@127.0.0.1:3306/firsthome?charset=utf8mb4

# 로그인 토큰 서명용 비밀값 (아무 긴 무작위 문자열로 바꾸세요)
JWT_SECRET=change-this-to-a-long-random-string

# 프론트엔드 주소 (개발 서버 기본값)
FRONTEND_ORIGIN=http://localhost:5173

# ---------------- AI ----------------
# auto  : OPENAI_API_KEY가 있으면 OpenAI 호출, 없으면 규칙 기반(목업) 응답
# mock  : 항상 규칙 기반 응답 (API 비용 0, 시연 리허설용)
# openai: 항상 OpenAI 호출 (실패하면 규칙 기반으로 대체하고 화면에 표시)
AI_MODE=auto

# 교수님께 받은 키를 여기에만 넣으세요. 절대 프론트엔드 코드나 GitHub에 넣지 마세요.
OPENAI_API_KEY=
# 비워 두면 이 키로 쓸 수 있는 경량 모델을 서버가 자동으로 고릅니다 (gpt-4.1-mini → gpt-4o-mini 순).
# 특정 모델을 쓰라는 안내를 받았을 때만 이름을 넣으세요.
OPENAI_MODEL=

# 비용 관리
AI_MAX_OUTPUT_TOKENS=1500
AI_DAILY_LIMIT_PER_USER=30
AI_DAILY_LIMIT_TOTAL=300
AI_NOTE_MAX_CHARS=200
# 비워 두면 temperature를 보내지 않습니다(일부 모델은 지원하지 않음)
AI_TEMPERATURE=
# 추론(reasoning) 모델을 쓸 때 비용을 줄이려면 low 등을 넣으세요. 모델이 지원하지 않으면 비워 두세요.
AI_REASONING_EFFORT=

# ---------------- 국토교통부 실거래가 (공공데이터포털) ----------------
# auto : 키가 있으면 실제 API, 없으면 '예시 데이터'(화면에 예시라고 표시)
# mock : 항상 예시 데이터 / live : 항상 실제 API
MOLIT_MODE=auto
# 공공데이터포털 마이페이지의 '일반 인증키(Decoding)' 값을 넣으세요. GitHub에 올리지 마세요.
MOLIT_API_KEY=
# 최근 몇 개월 거래를 볼지 (1~12)
MOLIT_MONTHS=6

# ================ 배포 서버(호스팅)에서 설정할 값 ================
# 아래 값은 호스팅 서비스의 '환경변수' 설정 화면에 넣으세요. (이 파일에는 실제 값을 쓰지 마세요)
# APP_ENV=production            # 운영 모드 (JWT_SECRET 검사)
# JWT_SECRET=                    # 32자 이상 무작위 문자열: python -c "import secrets;print(secrets.token_urlsafe(48))"
# COOKIE_SECURE=true             # https 주소에서만 로그인 쿠키 전송
# DATABASE_URL=mysql://사용자:비밀번호@호스트:포트/DB이름   # 호스팅 MySQL 주소 (mysql:// 그대로 붙여 넣어도 됨)
# DB_SSL=true                    # 클라우드 MySQL이 암호화 연결을 요구하면
# ADMIN_EMAILS=내이메일@example.com   # 만족도 설문 결과를 볼 계정
# SEED_DEMO=true                 # 데모 계정(demo@firsthome.app) 자동 생성
# AI_DAILY_LIMIT_PER_USER=15     # 공개 테스트 기간 OpenAI 비용 보호
# AI_DAILY_LIMIT_TOTAL=200
